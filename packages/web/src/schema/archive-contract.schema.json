{
  "$defs": {
    "Actor": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "person",
            "tool",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AncillaryOf": {
      "additionalProperties": true,
      "description": "The column this one qualifies, and how: its uncertainty, detection limit or flag.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "role": {
          "enum": [
            "uncertainty",
            "detection-limit",
            "quality-flag"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "field",
        "role"
      ],
      "title": "AncillaryOf",
      "type": "object"
    },
    "ArchiveConfig": {
      "additionalProperties": true,
      "description": "Which profiles apply, extra required fields, vocabularies, themes, the licenses and\naccess levels offered, and the publisher the archive fills in at publish.",
      "properties": {
        "access": {
          "items": {
            "enum": [
              "open",
              "restricted",
              "by-request",
              "description-only"
            ],
            "type": "string"
          },
          "title": "Access",
          "type": "array"
        },
        "infrastructure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Infrastructure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "licenses": {
          "items": {
            "type": "string"
          },
          "title": "Licenses",
          "type": "array"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "title": "Themes",
          "type": "array"
        },
        "vocabularies": {
          "items": {
            "$ref": "#/$defs/Vocabulary"
          },
          "title": "Vocabularies",
          "type": "array"
        }
      },
      "required": [
        "publisher"
      ],
      "title": "ArchiveConfig",
      "type": "object"
    },
    "Change": {
      "additionalProperties": true,
      "description": "One cleaning step: what changed, who made and accepted it, why, and the evidence.\n\n`before` and `after` keep an explicit null (a value filled in from nothing has\n`\"before\": null`); when never set they are left out.",
      "properties": {
        "acceptedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after": {
          "default": null,
          "title": "After"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "madeBy": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "when": {
          "format": "date-time",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "id",
        "when",
        "madeBy",
        "kind",
        "target",
        "reason"
      ],
      "title": "Change",
      "type": "object"
    },
    "CheckCount": {
      "additionalProperties": true,
      "description": "How many of the checks that applied passed.",
      "properties": {
        "applicable": {
          "minimum": 0,
          "title": "Applicable",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "applicable"
      ],
      "title": "CheckCount",
      "type": "object"
    },
    "Contributor": {
      "additionalProperties": true,
      "description": "A Frictionless v2 contributor. A creator is a contributor with the `creator` role.",
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "familyName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Familyname"
        },
        "givenName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Givenname"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roles"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "Contributor",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": true,
      "description": "The rows or values that show the problem or justify the change.\n\n`count` is how many rows show it, since a problem on thousands of rows can't list them all.",
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "rows": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Field": {
      "additionalProperties": true,
      "description": "One column of a table, described by logical type rather than file format.\n\n`name` is the column's name in the tidy table. When a rename was accepted, the column's\nname in the source file is kept in `archive:sourceName`. `archive:unit` is free text\n(`degC`, `mg/L`); `archive:ancillaryOf` names another column of the same schema that\nthis one qualifies.",
      "properties": {
        "archive:ancillaryOf": {
          "anyOf": [
            {
              "$ref": "#/$defs/AncillaryOf"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "archive:codeList": {
          "anyOf": [
            {
              "const": "undocumented",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive:Codelist"
        },
        "archive:measurementScale": {
          "anyOf": [
            {
              "enum": [
                "nominal",
                "ordinal",
                "interval",
                "ratio",
                "dateTime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive:Measurementscale"
        },
        "archive:sensitivity": {
          "anyOf": [
            {
              "enum": [
                "personal",
                "sensitive-location",
                "confidential"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive:Sensitivity"
        },
        "archive:sourceName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive:Sourcename"
        },
        "archive:unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive:Unit"
        },
        "constraints": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "example": {
          "default": null,
          "title": "Example"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "object",
                "array",
                "list",
                "datetime",
                "date",
                "time",
                "year",
                "yearmonth",
                "duration",
                "geopoint",
                "geojson",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "Field",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "description": "One problem found in a package, by the rule with id `ruleId`.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ruleId": {
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "note"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestedFix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestedfix"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ruleId",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ForeignKey": {
      "additionalProperties": true,
      "description": "A link from columns of this table to columns of another, such as a code list.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "Fields"
        },
        "reference": {
          "$ref": "#/$defs/ForeignKeyReference"
        }
      },
      "required": [
        "fields",
        "reference"
      ],
      "title": "ForeignKey",
      "type": "object"
    },
    "ForeignKeyReference": {
      "additionalProperties": true,
      "description": "What a foreign key points at. With no `resource` it points into the same table.",
      "properties": {
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "Fields"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        }
      },
      "required": [
        "fields"
      ],
      "title": "ForeignKeyReference",
      "type": "object"
    },
    "Funding": {
      "additionalProperties": true,
      "properties": {
        "awardNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Awardnumber"
        },
        "awardTitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Awardtitle"
        },
        "awardUri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Awarduri"
        },
        "funder": {
          "title": "Funder",
          "type": "string"
        }
      },
      "required": [
        "funder"
      ],
      "title": "Funding",
      "type": "object"
    },
    "Infrastructure": {
      "additionalProperties": false,
      "description": "Where and how the archive is deployed.",
      "properties": {
        "alertEmail": {
          "title": "Alertemail",
          "type": "string"
        },
        "modules": {
          "$ref": "#/$defs/Modules"
        },
        "monthlyBudgetUsd": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Monthlybudgetusd",
          "type": "integer"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "alertEmail"
      ],
      "title": "Infrastructure",
      "type": "object"
    },
    "LegacyIdentifier": {
      "additionalProperties": true,
      "description": "An identifier the data had elsewhere, such as an EML package id.",
      "properties": {
        "scheme": {
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "LegacyIdentifier",
      "type": "object"
    },
    "License": {
      "additionalProperties": true,
      "description": "A Frictionless license: an SPDX id in `name`, a license URL in `path`, or both.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "License",
      "type": "object"
    },
    "Link": {
      "additionalProperties": true,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "MemberFile": {
      "additionalProperties": true,
      "description": "One file of a resource made of several files that only work together.",
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MemberFile",
      "type": "object"
    },
    "MetadataEdit": {
      "additionalProperties": true,
      "description": "One in-place metadata edit of the current version.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "when": {
          "format": "date-time",
          "title": "When",
          "type": "string"
        },
        "who": {
          "title": "Who",
          "type": "string"
        }
      },
      "required": [
        "when",
        "who",
        "fields"
      ],
      "title": "MetadataEdit",
      "type": "object"
    },
    "Modules": {
      "additionalProperties": false,
      "description": "The optional parts, each built only when switched on.",
      "properties": {
        "objectLock": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectLock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "waf": {
          "default": false,
          "title": "Waf",
          "type": "boolean"
        }
      },
      "title": "Modules",
      "type": "object"
    },
    "ObjectLock": {
      "additionalProperties": false,
      "description": "Write-once locking of the archive bucket, in governance mode.",
      "properties": {
        "retentionDays": {
          "exclusiveMinimum": 0,
          "title": "Retentiondays",
          "type": "integer"
        }
      },
      "required": [
        "retentionDays"
      ],
      "title": "ObjectLock",
      "type": "object"
    },
    "Person": {
      "additionalProperties": true,
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "orcid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Person",
      "type": "object"
    },
    "Project": {
      "additionalProperties": true,
      "description": "A monitoring program, a grant or a long-term study.\n\nA package names its project with `archive:project: <id>` and never copies its text.",
      "properties": {
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "keywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keywords"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "title": "People",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Project",
      "type": "object"
    },
    "QualityVerdict": {
      "additionalProperties": true,
      "description": "The counts of findings by severity from the last audit, and the completeness score.\n\n`score` is the share of checks passed, as a whole percent rounded down; `find`,\n`understand` and `trust` count the checks for each of the three questions.",
      "properties": {
        "auditedAt": {
          "format": "date-time",
          "title": "Auditedat",
          "type": "string"
        },
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "find": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "minimum": 0,
          "title": "Notes",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "understand": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
